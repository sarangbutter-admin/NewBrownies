# Set these in Netlify: Site configuration → Environment variables. NEVER commit real values.
# Long random text, at least 32 characters. Signs login cookies. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# One-time key (12+ characters) that lets YOU create the owner account the first time. Choose any long phrase and keep it private.
OWNER_SETUP_KEY=
